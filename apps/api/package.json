{
  "name": "@quickcart/api",
  "version": "0.1.0",
  "private": true,
  "description": "QuickCart backend — NestJS modular monolith",
  "scripts": {
    "build": "npm run db:generate && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "nest start --watch",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@nestjs/common": "~12.6.0",
    "@nestjs/core": "~12.6.0",
    "@nestjs/jwt": "^12.0.5",
    "@nestjs/platform-express": "~12.6.0",
    "@nestjs/platform-socket.io": "^12.6.0",
    "@nestjs/swagger": "~12.1.2",
    "@nestjs/throttler": "^6.8.0",
    "@nestjs/websockets": "^12.6.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@quickcart/shared": "*",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.10",
    "helmet": "^8.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "~7.8.2",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@nestjs/cli": "^12.0.15",
    "@quickcart/config": "*",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "cross-env": "^10.0.0",
    "eslint": "^9.0.0",
    "jest": "^30.5.2",
    "prisma": "7.10.1",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  }
}
