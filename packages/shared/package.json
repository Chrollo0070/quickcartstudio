{
  "name": "@quickcart/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Shared types, constants and pure helpers for QuickCart",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@quickcart/config": "*",
    "eslint": "^9.39.0",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  }
}
